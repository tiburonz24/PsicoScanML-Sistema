generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================
// USUARIOS Y ROLES
// =============================================

model Usuario {
  id           String      @id @default(cuid())
  email        String      @unique
  password     String
  nombre       String
  rol          Rol
  creadoEn     DateTime    @default(now())
  estudianteId String?     @unique
  estudiante   Estudiante? @relation(fields: [estudianteId], references: [id])
}

enum Rol {
  ESTUDIANTE
  PSICOLOGO
  ORIENTADOR
  DIRECTOR
  ADMIN
}

// =============================================
// ESTUDIANTES
// =============================================

model Estudiante {
  id            String     @id @default(cuid())
  curp          String     @unique
  nombre        String
  edad          Int
  sexo          Sexo
  grado         String
  grupo         String
  escuela       String
  tokenEncuesta String     @unique @default(cuid())
  usuario       Usuario?
  tamizajes     Tamizaje[]
  citas         Cita[]
  respuestasRaw RespuestasCuestionario[]
  expediente       ExpedienteClinico?
  sesiones         Sesion[]
  contactosPadres  ContactoPadres[]
  canalizaciones   Canalizacion[]
}

// =============================================
// RESPUESTAS CRUDAS DEL CUESTIONARIO
// =============================================

model RespuestasCuestionario {
  id           String     @id @default(cuid())
  fecha        DateTime   @default(now())
  estudianteId String
  respuestas   Json
  procesado    Boolean    @default(false)
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id])
}

enum Sexo {
  MASCULINO
  FEMENINO
  OTRO
}

// =============================================
// TAMIZAJES (resultado del SENA + clasificacion ML)
// =============================================

model Tamizaje {
  id           String   @id @default(cuid())
  fecha        DateTime @default(now())
  estudianteId String

  // Escalas de control
  inc Float
  neg Float
  pos Float

  // Indices globales — el SENA los calcula combinando varias sub-escalas ya
  // normalizadas por baremo; sin baremo oficial no se pueden derivar de los
  // items crudos. Quedan null hasta que exista una fuente real (ver
  // escalasCalculadas).
  glo_t Int?
  emo_t Int?
  con_t Int?
  eje_t Int?
  ctx_t Int?
  rec_t Int?

  // Problemas interiorizados — puntuacion directa (PD, suma de items 1-5),
  // NO puntuacion T normalizada. Ver escalasCalculadas.
  dep_t Int
  ans_t Int
  asc_t Int
  som_t Int
  pst_t Int
  obs_t Int

  // Problemas exteriorizados (PD, ver nota arriba)
  ate_t Int
  hip_t Int
  ira_t Int
  agr_t Int
  des_t Int
  ant_t Int

  // Otros problemas (PD, ver nota arriba)
  sus_t Int
  esq_t Int
  ali_t Int

  // Problemas contextuales (PD, ver nota arriba)
  fam_t Int
  esc_t Int
  com_t Int

  // Vulnerabilidades — este codebase nunca definio el mapeo item->escala
  // para REG/BUS (a diferencia de las demas escalas en lib/sena/scoring.ts),
  // asi que no hay forma de calcularlas ni siquiera como PD. Quedan null.
  reg_t Int?
  bus_t Int?

  // Recursos personales (PD, ver nota arriba)
  aut_t Int
  soc_t Int
  cnc_t Int

  // true solo cuando estos valores son puntuaciones T reales (baremo oficial
  // aplicado, ej. transcritas de un PDF SENA o de una tabla de conversion
  // validada). Mientras sea false, los campos "_t" arriba son PD crudas o
  // null — nunca puntuaciones T reales.
  escalasCalculadas Boolean @default(false)

  // Resultado del modelo ML
  tipoCaso      TipoCaso
  semaforo      Semaforo
  observaciones String?
  itemsCriticos Json

  estudiante Estudiante @relation(fields: [estudianteId], references: [id])
}

enum TipoCaso {
  INCONSISTENCIA
  SIN_RIESGO
  IMPRESION_POSITIVA
  IMPRESION_NEGATIVA
  CON_RIESGO
}

enum Semaforo {
  VERDE
  AMARILLO
  ROJO
  ROJO_URGENTE
}

// =============================================
// CITAS
// =============================================

model Cita {
  id           String     @id @default(cuid())
  fecha        DateTime
  estado       EstadoCita @default(PENDIENTE)
  notas        String?
  estudianteId String
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id])
  sesion       Sesion?
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  COMPLETADA
  CANCELADA
}

// =============================================
// EXPEDIENTE CLÍNICO Y SESIONES
// =============================================

model ExpedienteClinico {
  id                    String           @id @default(cuid())
  estudianteId          String           @unique
  motivoConsulta        String?
  antecedentes          String?
  diagnosticoPreliminar String?
  planIntervencion      String?
  estado                EstadoExpediente @default(ACTIVO)
  nivelRiesgo           Int?             // 1-10 valoración clínica manual
  abiertaEn             DateTime         @default(now())
  actualizadaEn         DateTime         @updatedAt
  estudiante            Estudiante       @relation(fields: [estudianteId], references: [id])
}

model ContactoPadres {
  id           String            @id @default(cuid())
  estudianteId String
  fecha        DateTime          @default(now())
  tipo         TipoContacto
  resultado    ResultadoContacto
  notas        String?
  estudiante   Estudiante        @relation(fields: [estudianteId], references: [id])
}

model Canalizacion {
  id                String             @id @default(cuid())
  estudianteId      String
  institucion       String
  tipoInstitucion   TipoInstitucion    @default(PUBLICA)
  tipoAtencion      String?
  motivo            String
  nivelRiesgo       Int?
  urgente           Boolean            @default(false)
  fecha             DateTime           @default(now())
  estado            EstadoCanalizacion @default(PENDIENTE)
  notas             String?
  firmaPadres       Boolean            @default(false)
  documentoRecibido Boolean            @default(false)
  tipoDocumento     String?
  fechaDocumento    DateTime?
  estudiante        Estudiante         @relation(fields: [estudianteId], references: [id])
}

enum TipoContacto {
  LLAMADA
  MENSAJE_TEXTO
  CONTACTO_POR_ALUMNO
  CITA_PADRES
}

enum ResultadoContacto {
  CONTESTO
  NO_CONTESTO
  MENSAJE_ENVIADO
  SIN_RESPUESTA
  ACUDIO
  NO_ACUDIO
}

enum TipoInstitucion {
  PUBLICA
  PRIVADA
}

enum EstadoCanalizacion {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  SIN_SEGUIMIENTO
}

model Sesion {
  id              String     @id @default(cuid())
  fecha           DateTime   @default(now())
  tipo            TipoSesion @default(SEGUIMIENTO)
  motivo          String?
  notas           String
  acuerdos        String?
  planActualizado String?
  citaId          String?    @unique
  estudianteId    String
  estudiante      Estudiante @relation(fields: [estudianteId], references: [id])
  cita            Cita?      @relation(fields: [citaId], references: [id])
}

enum EstadoExpediente {
  ACTIVO
  CERRADO
  DERIVADO
  EN_ESPERA
}

enum TipoSesion {
  EVALUACION_INICIAL
  SEGUIMIENTO
  INTERVENCION
  CRISIS
  CIERRE
  DEVOLUCION
}

// =============================================
// HISTÓRICO SENA — corpus de entrenamiento ML
// =============================================

model HistoricoSENA {
  id         String   @id @default(cuid())
  origen     String   @default("importacion")
  fecha      DateTime
  edad       Int
  sexo       String
  baremo     String?
  respuestas String?  // cadena de 188 dígitos
  semaforo   Semaforo // derivado con calcularResultado()

  // Escalas de control (puntuación directa + T)
  pdInc Float @default(0)
  ptInc Int   @default(50)
  pdNeg Float @default(0)
  ptNeg Int   @default(50)
  pdPos Float @default(0)
  ptPos Int   @default(50)

  // Índices globales (puntuación T)
  gloT Int @default(50)
  emoT Int @default(50)
  conT Int @default(50)
  ejeT Int @default(50)
  ctxT Int @default(50)
  recT Int @default(50)

  // Problemas interiorizados (T)
  depT Int @default(50)
  ansT Int @default(50)
  ascT Int @default(50)
  somT Int @default(50)
  pstT Int @default(50)
  obsT Int @default(50)

  // Problemas exteriorizados (T)
  ateT Int @default(50)
  hipT Int @default(50)
  iraT Int @default(50)
  agrT Int @default(50)
  desT Int @default(50)
  antT Int @default(50)

  // Otros problemas (T)
  susT Int @default(50)
  esqT Int @default(50)
  aliT Int @default(50)

  // Problemas contextuales (T)
  famT Int @default(50)
  escT Int @default(50)
  comT Int @default(50)

  // Vulnerabilidades (T)
  regT Int @default(50)
  busT Int @default(50)

  // Recursos personales (T)
  autT Int @default(50)
  socT Int @default(50)
  cncT Int @default(50)

  creadoEn DateTime @default(now())
}

// =============================================
// HISTÓRICO DE ENTRENAMIENTOS ML
// =============================================

model EntrenamientoML {
  id          String   @id @default(cuid())
  fecha       DateTime @default(now())
  nRegistros  Int
  trainSize   Float
  accuracy    Float
  cvMean      Float
  cvStd       Float
  nEstimators Int
  report      Json     // classification_report por clase
  importance  Json     // [{ feature, importance }, ...]
}
